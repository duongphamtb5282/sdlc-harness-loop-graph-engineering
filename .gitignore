# ═══════════════════════════════════════════════════════════════
# Nexus Agent Kernel — .gitignore
# Curated project docs (documents/project/) ARE published;
# third-party libraries, generated artifacts, frozen upstream,
# and local runtime state stay private.
# ═══════════════════════════════════════════════════════════════

# ── Not published (stay local) ────────────────────────────────
# bmad-builder: BMAD-branded vendored project (brand-neutral rule —
# core-skills libraries are committed; this one stays private)
kernel/core-skills/bmad-builder/

# ── Secrets & credentials (NEVER commit) ──────────────────────
.env
.env.*
!.env.example
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/
**/service-account*.json
**/firebase-adminsdk*.json

# ── Dependencies (generated) ──────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.uv/
.pub-cache/

# ── IDE / Editor / OS ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log

# ── Build / Generated code ────────────────────────────────────
dist/
build/
*.tsbuildinfo
*.freezed.dart
*.g.dart

# ── Ruflo harness runtime (local state — NEVER commit) ────────
.claude-flow/
.agents/
.swarm/
.mcp.json
agentdb.rvf
agentdb.rvf.lock
.claude/helpers/
.claude/settings.json
.claude/settings.local.json

# ── MCP credentials (user-specific) ───────────────────────────
kernel/mcp/**/.env
kernel/mcp/**/*.json.local
kernel/mcp/**/*.local.json

# ── Nexus generated / workspace state ──────────────────────────
_nexus/
_nexus_old/
projects/**/.sdlc-automation-agent/
projects/**/cost-state.json

# ── Test artifacts ────────────────────────────────────────────
coverage/
*.lcov

# ── Git internals (defense-in-depth for nested clones) ────────
.git/
.gitmodules

# ── Temporary files ───────────────────────────────────────────
*.tmp
*.bak
*.orig
